# ============================================
# Indonesian Stock ML Service - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# cp .env.example .env

# ============================================
# Laravel API Configuration
# ============================================
# Base URL of the Laravel API for fetching stock data
LARAVEL_API_BASE_URL=http://localhost:8000

# API Key for authenticating with Laravel API (if required)
# Leave empty if Laravel API doesn't require authentication
LARAVEL_API_KEY=your_laravel_api_key_here

# Timeout for requests to Laravel API (in seconds)
# Increase this if you have large datasets or slow network
LARAVEL_API_TIMEOUT=30

# ============================================
# ML Service Configuration
# ============================================
# Port where the ML service will run
ML_SERVICE_PORT=8001

# Host address for the ML service
# Use 0.0.0.0 to accept connections from all interfaces
# Use 127.0.0.1 to only accept local connections
ML_SERVICE_HOST=0.0.0.0

# API Key for securing the ML service endpoints
# If set, all protected endpoints require this key
# Can be provided via X-API-Key header or Authorization: Bearer header
# Leave empty to disable API key authentication
ML_SERVICE_API_KEY=your_ml_service_api_key_here

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for development, INFO for production
LOG_LEVEL=INFO

# ============================================
# Storage Configuration
# ============================================
# Path where trained models will be stored
# Models are saved in H5 format (Keras/TensorFlow)
MODEL_STORAGE_PATH=./models

# Path for storing training data (optional)
# Used for caching preprocessed data
TRAINING_DATA_PATH=./data

# Time-to-live for prediction cache (in seconds)
# Predictions are cached to improve performance
# Set to 0 to disable caching
PREDICTION_CACHE_TTL=3600

# ============================================
# Database Configuration (Optional)
# ============================================
# Uncomment these if you want direct database access
# instead of using Laravel API for data fetching
# This can improve performance but requires database credentials

# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=your_password

# ============================================
# Environment
# ============================================
# Set to 'development' for auto-reload, 'production' for optimized mode
ENVIRONMENT=development
