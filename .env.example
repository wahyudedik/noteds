APP_NAME=Noteds
APP_ENV=production
APP_KEY=base64:change_me_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://noteds.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=notice

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noteds_database
DB_USERNAME=noteds_user
DB_PASSWORD=your_secure_password_here

SESSION_DRIVER=redis
SESSION_LIFETIME=1440
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=noteds.com

# Session configuration untuk HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CACHE_DRIVER=file
CACHE_STORE=redis
CACHE_PREFIX=noteds_prod_

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_CACHE_DB=1
REDIS_SESSION_DB=0
REDIS_TIMEOUT=5.0
REDIS_READ_TIMEOUT=10.0

MAIL_MAILER=smtp
MAIL_HOST=your_mail_host.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@noteds.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=noteds.com

MIDTRANS_SERVER_KEY=Mid-server-your_server_key_here
MIDTRANS_CLIENT_KEY=Mid-client-your_client_key_here
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_MERCHANT_ID=your_merchant_id

SENTRY_LARAVEL_DSN=https://your_key_here@your_organization.ingest.sentry.io/your_project_id
SENTRY_TRACES_SAMPLE_RATE=1.0

# Telescope Query Monitoring (disable in production for security and performance)
TELESCOPE_ENABLED=false
TELESCOPE_QUERY_WATCHER=false
TELESCOPE_SLOW_QUERY_THRESHOLD=100  # milliseconds

# Cloudflare Settings
# Set to false to disable Cloudflare Insights (if you don't want analytics tracking)
CLOUDFLARE_INSIGHTS_ENABLED=true

# atau mailchimp, sendgrid
EMAIL_CAMPAIGN_PROVIDER=laravel  
MAILCHIMP_API_KEY=your_key
MAILCHIMP_LIST_ID=your_list_id
SENDGRID_API_KEY=your_key

CLAMAV_CONNECTION_TYPE=socket
CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl
CLAMAV_AUTO_QUARANTINE=true
CLAMAV_REALTIME_SCANNING=true
CLAMAV_QUARANTINE_PATH=/var/quarantine/clamav

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://noteds.com/auth/google/callback

# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=https://noteds.com/auth/facebook/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://noteds.com/auth/github/callback
